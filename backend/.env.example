# ---- Database ----
DATABASE_URL=mysql+pymysql://ffuser:ffpassword@localhost:3306/feature_flags?charset=utf8mb4

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
ANALYTICS_RETENTION_DAYS=90

# ---- JWT (generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))") ----
JWT_SECRET_KEY=change-this-secret-key-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Security ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Scheduler ----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# ---- Seed ----
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin@123
SEED_DEMO_DATA=true
DEBUG=false
